/* open/close/read/write are declared on the same "ioman" import table
 * already used above by AddDrv/DelDrv (so it is certainly present at
 * runtime, unlike a modern separate "iomanx" library, which the IOP
 * environment POPStarter runs in may not have registered - an unresolvable
 * import makes the loader refuse to load the whole module). Same ordinals
 * as <iomanX.h> (4/5/7, checked against ps2sdk iop/system/iomanx), but bound
 * to the "ioman" library instead of a separate "iomanx". The local names
 * iomanX_open/_write/_close are unchanged: they are what the code
 * references through the inlines of <iomanX.h>. */
ioman_IMPORTS_start
I_AddDrv
I_DelDrv
I_open
I_close
I_read
DECLARE_IMPORT(4, iomanX_open)
DECLARE_IMPORT(7, iomanX_write)
DECLARE_IMPORT(5, iomanX_close)
ioman_IMPORTS_end

thsemap_IMPORTS_start
I_CreateSema
I_SignalSema
I_WaitSema
I_DeleteSema
thsemap_IMPORTS_end
