/* BDM Export TAB. remains as is since FATFS has no exports*/

/* Needed because the dev9 table below uses macro names (dev9IntrEnable,
 * dev9DmaTransfer, etc.) that <dev9.h> expands to the real internal names
 * (SpdIntrEnable, SpdDmaTransfer, etc.) - net_dev9.c is compiled with those
 * real names because it includes the same header; without this include,
 * DECLARE_EXPORT(dev9IntrEnable) would stay literal and would not find the
 * right symbol. */
#include <dev9.h>

DECLARE_EXPORT_TABLE(bdm, 1, 1)
	DECLARE_EXPORT(_start)
	DECLARE_EXPORT(_retonly)
	DECLARE_EXPORT(_retonly)
	DECLARE_EXPORT(_retonly)
	DECLARE_EXPORT(bdm_connect_bd)
	DECLARE_EXPORT(bdm_disconnect_bd)
	DECLARE_EXPORT(bdm_connect_fs)
	DECLARE_EXPORT(bdm_disconnect_fs)
	DECLARE_EXPORT(bdm_get_bd)
	DECLARE_EXPORT(bdm_RegisterCallback)
END_EXPORT_TABLE

/* The "dev9" export table is REQUIRED (even if no other module imports
 * it): <dev9.h> generates indirect references to some functions through
 * _exp_dev9, which the linker resolves only if this table exists somewhere
 * in the final binary. The original problem ("multiple definition of
 * SpdIntrEnable") was not caused by this table but by a duplicated
 * dev9_IMPORTS_start block in imports.lst (removed, must not be added
 * back). */
DECLARE_EXPORT_TABLE(dev9, 1, 9)
	DECLARE_EXPORT(_start)
	DECLARE_EXPORT(_retonly)
	DECLARE_EXPORT(_exit)
	DECLARE_EXPORT(_retonly)

	/* 4 */
	DECLARE_EXPORT(dev9RegisterIntrCb)
	DECLARE_EXPORT(dev9DmaTransfer)
	DECLARE_EXPORT(dev9Shutdown)
	DECLARE_EXPORT(dev9IntrEnable)
	DECLARE_EXPORT(dev9IntrDisable)
	DECLARE_EXPORT(dev9GetEEPROM)
	DECLARE_EXPORT(dev9LEDCtl)
	DECLARE_EXPORT(dev9RegisterShutdownCb)
	DECLARE_EXPORT(dev9RegisterPreDmaCb)
	DECLARE_EXPORT(dev9RegisterPostDmaCb)
	DECLARE_EXPORT(dev9ControlPIO3)
	DECLARE_EXPORT(dev9LED2Ctl)
END_EXPORT_TABLE

void _retonly() {}
